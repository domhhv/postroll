{
  "name": "postroll",
  "version": "0.1.0",
  "description": "A system designed to manage and process media files with an efficient and structured approach, ensuring that they are executed in an organized manner.",
  "author": "Dominik Hryshaiev <domhryshaiev@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/domhhv/postroll.git"
  },
  "keywords": [],
  "scripts": {
    "prepare": "husky",
    "dev": "TURBO_UI=1 turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "biome:check": "turbo biome:check",
    "biome:write": "turbo biome:write",
    "db:start": "pnpm --filter @postroll/database start",
    "ui": "pnpm --filter @postroll/ui ui"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3"
  }
}
