{
  "name": "postroll",
  "version": "0.1.0",
  "private": true,
  "description": "A system designed to manage and process media files with an efficient and structured approach, ensuring that they are executed in an organized manner.",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/domhhv/postroll.git"
  },
  "license": "ISC",
  "author": {
    "name": "Dominik Hryshaiev",
    "email": "domhryshaiev@gmail.com",
    "url": "https://domhhv.com"
  },
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "db:migrate": "pnpm --filter @postroll/database db:migrate",
    "db:reset": "pnpm --filter @postroll/database db:reset",
    "db:start": "pnpm --filter @postroll/database db:start",
    "db:stop": "pnpm --filter @postroll/database db:stop",
    "db:studio": "pnpm --filter @postroll/database studio",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:root": "eslint './*.{js,mjs,cjs}' --config ./eslint.config.mjs",
    "lint:root:fix": "eslint --fix './*.{js,mjs,cjs}' --config ./eslint.config.mjs",
    "prepare": "husky",
    "prettier:check": "turbo prettier:check",
    "prettier:check:root": "prettier --check './*.{js,mjs,cjs,json,md}' './.github/workflows/*.yml' --config ./prettier.config.mjs",
    "prettier:write": "turbo prettier:write",
    "prettier:write:root": "prettier --write './*.{js,mjs,cjs,json,md}' './.github/workflows/*.yml' --config ./prettier.config.mjs",
    "sort-package-json": "turbo sort-package-json",
    "sort-package-json:check": "turbo sort-package-json:check",
    "ui": "pnpm --filter @postroll/ui ui"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@postroll/configs": "workspace:*",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sort-package-json": "^4.1.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.22.2"
  }
}
