AMQP_URL=amqp://guest:guest@localhost:5672
APP_URL=http://localhost:3000
EMAIL_FROM="Postroll <hello@postroll.video>"
# "log" writes emails to the OS temp folder; "resend" sends them and needs RESEND_API_KEY.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_REPLY_TO=
# Optional, log transport only: "retryable" or "permanent" makes every send fail.
EMAIL_LOG_SIMULATE=
# Resend allows 2 requests per second per team by default; sends are paced to this.
EMAIL_SENDS_PER_SECOND=2
# "debug" adds rate-limit waits and Resend response details.
LOG_LEVEL=info
