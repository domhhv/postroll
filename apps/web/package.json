{
  "name": "@postroll/web",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#env": "./src/env.ts",
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build": "next build --webpack",
    "build:cf": "opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check-types": "tsc --noEmit",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check",
    "start": "next start",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@postroll/contracts": "workspace:*",
    "@postroll/env": "workspace:*",
    "@tabler/icons-react": "^3.49.0",
    "add": "^2.0.9",
    "jose": "^6.2.12",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "set-cookie-parser": "^3.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@postroll/configs": "workspace:*",
    "@postroll/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.1"
  }
}
