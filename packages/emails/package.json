{
  "name": "@postroll/emails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "preview": "email dev --dir src/templates --port 3030",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check"
  },
  "dependencies": {
    "@postroll/contracts": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.8"
  },
  "devDependencies": {
    "@postroll/configs": "workspace:*",
    "@react-email/ui": "6.11.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
