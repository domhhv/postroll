{
  "name": "@postroll/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./users": {
      "types": "./dist/users.d.ts",
      "import": "./dist/users.js",
      "default": "./dist/users.js"
    },
