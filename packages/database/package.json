{
  "name": "@postroll/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "postroll-check-env ./src/env.ts migrationEnvSchema && prisma migrate dev",
    "db:deploy": "postroll-check-env ./src/env.ts migrationEnvSchema && prisma migrate deploy",
    "db:reset": "postroll-check-env ./src/env.ts migrationEnvSchema && prisma migrate reset",
    "db:start": "postroll-check-env ./src/env.ts dockerEnvSchema && node ./scripts/check-docker.mjs && docker compose up -d",
    "db:stop": "docker compose down",
    "studio": "postroll-check-env ./src/env.ts migrationEnvSchema && prisma studio"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@postroll/env": "workspace:*",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@postroll/biome-config": "workspace:^",
    "@postroll/typescript-config": "workspace:*",
    "@types/node": "^24.12.2",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0"
  }
}
