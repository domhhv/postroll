{
  "name": "@postroll/messaging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "dev": "node ./scripts/teardown-on-exit.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "mq:start": "node ./scripts/check-docker.mjs && docker compose up -d --wait",
    "mq:stop": "docker compose down --volumes",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check"
  },
  "dependencies": {
    "@postroll/contracts": "workspace:*",
    "rabbitmq-client": "^5.1.0"
  },
  "devDependencies": {
    "@postroll/configs": "workspace:*",
    "@types/node": "^24.19.2"
  }
}
