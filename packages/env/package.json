{
  "name": "@postroll/env",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js",
      "default": "./dist/format.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js",
      "default": "./dist/load.js"
    }
  },
  "bin": {
    "postroll-check-env": "./scripts/check-env.mjs"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@postroll/configs": "workspace:*",
    "@types/node": "^24.12.4"
  }
}
